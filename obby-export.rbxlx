  TimedTileInterval = 2.5,
  ConveyorSpeed = 18,
  BouncePower = 65,
  LavaRiseSpeed = 6,
  WindForce = 40,
  LaserCycleTime = 3,
}

return ObstacleConfig
]]></string>
